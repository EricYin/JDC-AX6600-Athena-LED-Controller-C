#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="screen_toggle screen_on screen_off"
EXTRA_HELP="        screen_toggle  Toggle screen power and save state to UCI"
PROG=/usr/bin/athena-led-c

load_uci() {
	config_load athena-led-c
	config_get_bool enabled main enabled 1
	config_get_bool screen_on main screen_on 1
	config_get custom_text main custom_text "ATHENA"
	config_get brightness main brightness 5
	config_get page_secs main page_secs 0
	config_get poll_ms main poll_ms 250
	config_get indicator_cpu_percent main indicator_cpu_percent 5
	config_get indicator_net_kbytes main indicator_net_kbytes 10
	config_get net_smoothing_secs main net_smoothing_secs 2
	config_get net_interface main net_interface wan

	pages_list=""
	append_page() {
		[ -n "$1" ] && pages_list="${pages_list}${pages_list:+,}$1"
	}
	config_list_foreach main pages append_page
	if [ -z "$pages_list" ]; then
		config_get pages_opt main pages ""
		[ -n "$pages_opt" ] && pages_list="$pages_opt"
	fi
	[ -z "$pages_list" ] && pages_list="time"
}

start_service() {
	load_uci
	[ "$enabled" -gt 0 ] || return 0
	mkdir -p /var/run
	rm -f /var/run/athena-led-c.btn-timeout
	"$PROG" -v > /var/run/athena-led-c.version 2>/dev/null || echo "0.4.2" > /var/run/athena-led-c.version

	procd_open_instance
	procd_set_param command "$PROG" \
		--screen-on "$screen_on" \
		--custom-text "$custom_text" \
		--brightness "$brightness" \
		--page-secs "$page_secs" \
		--poll-ms "$poll_ms" \
		--indicator-cpu-percent "$indicator_cpu_percent" \
		--indicator-net-kbytes "$indicator_net_kbytes" \
		--net-smoothing-secs "$net_smoothing_secs" \
		--net-interface "$net_interface" \
		--pages "$pages_list"
	procd_set_param pidfile /var/run/athena-led-c.pid
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "athena-led-c"
}

reload_service() {
	stop
	start
}

stop_service() {
	rm -f /var/run/athena-led-c.version /var/run/athena-led-c.screen /var/run/athena-led-c.btn-timeout
}
screen_toggle() {
	PID=$(cat /var/run/athena-led-c.pid 2>/dev/null)
	if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
		kill -USR2 "$PID" 2>/dev/null || true
	else
		CUR=$(uci -q get athena-led-c.main.screen_on || echo 1)
		[ "$CUR" = "0" ] && NEXT=1 || NEXT=0
		uci -q set athena-led-c.main.screen_on="$NEXT"
		uci -q commit athena-led-c
		echo "$NEXT" > /var/run/athena-led-c.screen
	fi
}

screen_on() {
	PID=$(cat /var/run/athena-led-c.pid 2>/dev/null)
	CUR=$(cat /var/run/athena-led-c.screen 2>/dev/null || uci -q get athena-led-c.main.screen_on || echo 1)
	if [ "$CUR" != "1" ]; then
		screen_toggle
	fi
}

screen_off() {
	PID=$(cat /var/run/athena-led-c.pid 2>/dev/null)
	CUR=$(cat /var/run/athena-led-c.screen 2>/dev/null || uci -q get athena-led-c.main.screen_on || echo 1)
	if [ "$CUR" != "0" ]; then
		screen_toggle
	fi
}

