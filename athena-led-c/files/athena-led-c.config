config main 'main'
	option enabled '1'
	option screen_on '1'
	option custom_text 'ATHENA'
	option brightness '5'
	option page_secs '0'
	list pages 'time'
	list pages 'net_down'
	list pages 'net_up'
	list pages 'mem'
	list pages 'cpu'
	list pages 'temp'
	list pages 'date'
	list pages 'lunar'
	option poll_ms '250'
	option indicator_cpu_percent '5'
	option indicator_net_kbytes '10'
	option net_smoothing_secs '2'
	option net_interface 'wan'
