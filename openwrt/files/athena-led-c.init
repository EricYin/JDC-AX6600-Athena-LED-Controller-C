#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/athena-led-c

load_uci() {
	config_load athena-led-c
	config_get_bool enabled main enabled 1
	config_get brightness main brightness 5
	config_get page_secs main page_secs 5
	config_get_bool scroll_enable main scroll_enable 1
	config_get scroll_ms main scroll_ms 128
	config_get poll_ms main poll_ms 250
	config_get net_interface main net_interface br-lan
	config_get sun_coords main sun_coords '39.90,116.40'
}

start_service() {
	load_uci
	[ "$enabled" -gt 0 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" \
		--brightness "$brightness" \
		--page-secs "$page_secs" \
		--scroll-ms "$scroll_ms" \
		--poll-ms "$poll_ms" \
		--net-interface "$net_interface" \
		--sun-coords "$sun_coords"
	[ "$scroll_enable" -eq 0 ] && procd_append_param command --no-scroll
	procd_set_param pidfile /var/run/athena-led-c.pid
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "athena-led-c"
}

reload_service() {
	stop
	start
}
