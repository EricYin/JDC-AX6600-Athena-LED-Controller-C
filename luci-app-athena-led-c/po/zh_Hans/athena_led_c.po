msgid "Athena LED (C)"
msgstr "雅典娜 LED (C版)"

msgid "Athena LED Controller (C)"
msgstr "京东云雅典娜 LED 点阵屏控制器 (纯 C 版)"

msgid "Pure C11 LED daemon for JDCloud AX6600 (RE-CS-02). Ultra-low resource usage, hardware TM1628A driver with local monitor pages."
msgstr "专为京东云雅典娜 AX6600 (RE-CS-02) 打造的纯 C11 LED 控制守护进程。超低系统资源开销，原生 TM1628A 硬件驱动与全本地监控轮播。"

msgid "Running Status"
msgstr "运行状态"

msgid "Collecting data..."
msgstr "正在获取状态..."

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Command failed with code %d"
msgstr "命令执行失败，返回码 %d"

msgid "Service action \"%s\" executed successfully."
msgstr "服务操作「%s」执行成功。"

msgid "Screen Preview"
msgstr "屏幕实时点阵预览"

msgid "Simulates the 27×5 LED matrix display in real-time. Supports digits, A-Z letters and symbols with amber glow effect."
msgstr "实时模拟真实 27×5 LED 点阵屏硬件显示效果。支持数字、英文字母及符号，还原琥珀色发光与微光晕效果。"

msgid "Type text to preview..."
msgstr "输入任意文本以实时预览..."

msgid "Preview Scrolling"
msgstr "模拟长文本滚动"

msgid "Click preset buttons below or type custom text"
msgstr "点击下方快捷按钮或在上框输入自定义内容"

msgid "Time"
msgstr "时钟"

msgid "Date (Static)"
msgstr "日期 (静态)"

msgid "Date (Full)"
msgstr "日期 (完整)"

msgid "Lunar"
msgstr "农历"

msgid "Sunset (Static)"
msgstr "日落时刻 (静态)"

msgid "Sunrise (Static)"
msgstr "日出时刻 (静态)"

msgid "Sun (Full)"
msgstr "日出日落 (完整)"

msgid "CPU"
msgstr "CPU"

msgid "Memory"
msgstr "内存"

msgid "Temperature"
msgstr "温度"

msgid "Download"
msgstr "下行网速"

msgid "Upload"
msgstr "上行网速"

msgid "Physical Button Gestures"
msgstr "机身物理按键手势说明"

msgid "Single Click: "
msgstr "单击屏幕按键："

msgid "Switch to next monitoring page immediately."
msgstr "立即切换至下一项监控页面。"

msgid "Double Click: "
msgstr "双击屏幕按键："

msgid "Jump directly back to the primary Time page."
msgstr "立即返回首页面（时钟）。"

msgid "Long Press (1.5s): "
msgstr "长按屏幕按键 (1.5秒)："

msgid "Toggle screen standby power (turn display ON or OFF)."
msgstr "切换屏幕待机供电（点亮或熄灭点阵屏）。"

msgid "General Settings"
msgstr "基本设置"

msgid "Enabled"
msgstr "启用服务"

msgid "Enable or disable the Athena LED screen service."
msgstr "开启或禁用雅典娜 LED 屏幕后台守护进程。"

msgid "Brightness Level"
msgstr "屏幕亮度级别"

msgid "Panel brightness level (0 to 7)."
msgstr "点阵屏硬件亮度级别（0 到 7）。"

msgid " (Dimmest)"
msgstr " (最暗)"

msgid " (Default)"
msgstr " (默认)"

msgid " (Brightest)"
msgstr " (最亮)"

msgid "Page Display Time (seconds)"
msgstr "页面轮播停留时间 (秒)"

msgid "Duration each monitor page stays on screen before advancing to the next page."
msgstr "每个监控页面在屏幕上保持显示的时间（秒），到期后自动平滑轮播到下一项。"

msgid "Text Scrolling"
msgstr "长文本滚动"

msgid "Enable smooth scrolling for long text. When disabled, all monitor pages switch to compact static formats (e.g. MM-DD for date, S:HH:MM for sunset) to completely eliminate scrolling jitter."
msgstr "当显示内容超出屏幕宽度（27列）时是否平滑滚动。关闭后将采用紧凑静态格式显示（例如日期以 MM-DD 居中静止显示，日落显示 S:HH:MM），彻底消除滚动晃眼感。"

msgid "Traffic Monitor Interface"
msgstr "流量监控网卡接口"

msgid "Network interface to monitor throughput for download and upload pages."
msgstr "上下行网速监控所统计的网卡接口（例如 br-lan 或 wan）。"

msgid "Coordinates for Sunrise/Sunset"
msgstr "日出日落经纬度坐标"

msgid "Latitude and longitude (\"lat,lon\") used by the local solar algorithm to calculate sunrise and sunset times."
msgstr "用于本地太阳算法计算日出日落时间的经纬度坐标（格式：\"纬度,经度\"，无需联网）。"

