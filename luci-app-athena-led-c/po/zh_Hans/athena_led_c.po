msgid "Physical Button Gestures"
msgstr "机身物理按键手势说明"

msgid "Single Click: "
msgstr "单击屏幕按键："

msgid "Manually flip to the next checked page in the rotation list."
msgstr "手动翻屏切换至下一个已勾选的显示页面。"

msgid "Double Click: "
msgstr "双击屏幕按键："

msgid "Jump directly back to the first checked page."
msgstr "立即跳回第一个已勾选的页面。"

msgid "Long Press (1.5s): "
msgstr "长按屏幕按键 (1.5秒)："

msgid "Toggle screen standby power (turn display ON or OFF)."
msgstr "切换屏幕待机供电（点亮或熄灭点阵屏）。"

msgid "General Settings"
msgstr "基本设置"

msgid "Enabled"
msgstr "启用服务"

msgid "Enable or disable the Athena LED screen service."
msgstr "开启或禁用雅典娜 LED 屏幕后台守护进程。"

msgid "Brightness Level"
msgstr "屏幕亮度级别"

msgid "Panel brightness level (0 to 7)."
msgstr "点阵屏硬件亮度级别（0 到 7）。"

msgid " (Dimmest)"
msgstr " (最暗)"

msgid " (Default)"
msgstr " (默认)"

msgid " (Brightest)"
msgstr " (最亮)"

msgid "Display Pages"
msgstr "显示内容选择 (复选框)"

msgid "Time (HH:MM:SS)"
msgstr "时钟 (HH:MM:SS 冒号跳动)"

msgid "Date (MM-DD)"
msgstr "日期 (MM-DD 单屏静态)"

msgid "Lunar Date (L:M.D)"
msgstr "农历日期 (L:月.日 单屏静态)"

msgid "Sunrise / Sunset (R: / S:)"
msgstr "日出/日落时刻 (白天日落S / 夜晚日出R)"

msgid "CPU Usage (C:%)"
msgstr "CPU 使用率 (C:%)"

msgid "Memory Usage (M:%)"
msgstr "内存使用率 (M:%)"

msgid "System Temperature (T:°C)"
msgstr "系统温度 (T:CPU.NSS°C)"

msgid "Download Speed (D:Bps)"
msgstr "下行网速 (D:实时下载速率)"

msgid "Upload Speed (U:Bps)"
msgstr "上行网速 (U:实时上传速率)"

msgid "Check the pages to display. If multiple pages are checked, the screen will switch between them. If only one is selected, it stays fixed on that page. Pages not currently displayed will NOT poll system metrics to save resources."
msgstr "勾选要显示的内容。勾选多个时按顺序翻屏切换；只勾选一个时固定停留在该屏。未处于显示状态的内容（或未勾选的内容）后台绝不进行监控采样，彻底杜绝无用系统开销。"

msgid "Page Display Time (seconds)"
msgstr "页面停留时间 (秒)"

msgid "Auto-rotation interval in seconds. Set to 0 to disable auto-rotation (manual switching via router button only). Greater than 0 enables automatic flipping."
msgstr "页面自动轮播停留时间（秒）。设置为 0 则完全不自动翻屏，仅通过机身按键手动切页；大于 0 则自动定时翻屏。"

msgid "Traffic Monitor Interface"
msgstr "流量监控网卡接口"

msgid "Network interface to monitor throughput for download and upload pages."
msgstr "上下行网速监控所统计的网卡接口（例如 br-lan 或 wan）。"

msgid "Coordinates for Sunrise/Sunset"
msgstr "日出日落经纬度坐标"

msgid "Latitude and longitude (\"lat,lon\") used by the local solar algorithm to calculate sunrise and sunset times."
msgstr "用于本地太阳算法计算日出日落时间的经纬度坐标（格式：\"纬度,经度\"，无需联网）。"

