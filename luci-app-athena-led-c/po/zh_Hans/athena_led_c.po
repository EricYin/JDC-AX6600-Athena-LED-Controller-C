msgid "Athena LED (C)"
msgstr "雅典娜 LED (C版)"

msgid "Athena LED Controller (C)"
msgstr "京东云雅典娜 LED 点阵屏控制器 (纯 C 版)"

msgid "Pure C11 LED daemon for JDCloud AX6600 (RE-CS-02). Ultra-low resource usage, hardware TM1628A driver with on-demand lazy monitoring."
msgstr "专为京东云雅典娜 AX6600 (RE-CS-02) 打造的纯 C11 LED 守护进程。极致超低系统开销，TM1628A 硬件驱动，单屏静态显示与按需惰性监控采样。"

msgid "Running Status"
msgstr "运行状态"

msgid "Collecting data..."
msgstr "正在获取状态..."

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Command failed with code %d"
msgstr "命令执行失败，返回码 %d"

msgid "Service action \"%s\" executed successfully."
msgstr "服务操作「%s」执行成功。"

msgid "Screen Preview"
msgstr "屏幕点阵预览"

msgid "Simulates the 27×5 LED matrix display in real-time. Each display item occupies exactly one single screen (static centered, no scrolling)."
msgstr "实时模拟真实 27×5 LED 点阵屏硬件显示效果。每个显示项严格只占一屏（居中静止显示，彻底去除横滚）。"

msgid "Type text to preview..."
msgstr "输入任意文本以实时预览..."

msgid "Click preset buttons below or type custom text"
msgstr "点击下方快捷按钮或在输入框输入文本预览单屏点阵"

msgid "Time"
msgstr "时钟"

msgid "Date"
msgstr "日期"

msgid "Lunar"
msgstr "农历"

msgid "Sunset"
msgstr "日落时刻"

msgid "Sunrise"
msgstr "日出时刻"

