msgid "Advanced Tuning"
msgstr "高级调优"

msgid "Scroll Interval (ms)"
msgstr "文字滚动步进间隔 (毫秒)"

msgid "Frame step interval in milliseconds for scrolling text that exceeds 27 columns (default 128ms)."
msgstr "当显示文本超过 27 列屏幕宽度时，平滑滚动的单步刷新毫秒数（默认 128ms）。"

msgid "Sampling Interval (ms)"
msgstr "硬件与数据采样间隔 (毫秒)"

msgid "System sensor sampling and button polling interval in milliseconds (default 250ms)."
msgstr "CPU/内存/温度采集及按键边缘检测的轮询间隔（默认 250ms，idle 状态下由 poll 挂起不占 CPU）。"

msgid "Service Control"
msgstr "服务操作"

msgid "Restart Service"
msgstr "重启服务"

msgid "Restart"
msgstr "重启"

msgid "Stop Service"
msgstr "停止服务"

msgid "Stop"
msgstr "停止"

