msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Athena LED"
msgstr "雅典娜 LED"

msgid "Athena LED Controller"
msgstr "京东云雅典娜 LED 点阵屏控制器"

msgid "Running Status"
msgstr "运行状态"

msgid "Collecting data..."
msgstr "正在获取状态..."

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Command failed with code %d"
msgstr "命令执行失败，返回码 %d"

msgid "Service action \"%s\" executed successfully."
msgstr "服务操作「%s」执行成功。"

msgid "Screen Preview & Display Features"
msgstr "屏幕点阵预览与显示功能勾选"

msgid "Click a feature button to preview it."
msgstr "点击功能按钮即可预览。"

msgid "Display Pages"
msgstr "显示页面选择"

msgid "Only checked features are saved to the rotation list."
msgstr "仅勾选的功能会保存到轮播列表。"

msgid "Time"
msgstr "时钟"

msgid "Date"
msgstr "日期"

msgid "Lunar"
msgstr "农历"

msgid "CPU"
msgstr "CPU 占用"

msgid "Memory"
msgstr "内存占用"

msgid "Temperature"
msgstr "系统温度"

msgid "Download"
msgstr "下载网速"

msgid "Upload"
msgstr "上传网速"

msgid "Simulates the 27×5 LED matrix in real-time. Check the boxes to select pages for rotation; click any label to preview its matrix."
msgstr "实时模拟真实 27×5 LED 点阵屏硬件显示效果。勾选复选框即可将其加入轮播队列；点击任意功能名称可在上方实时预览点阵。"

msgid "Physical Button Gestures"
msgstr "机身物理按键手势说明"

msgid "Single Click: "
msgstr "单击屏幕按键："

msgid "Manually flip to the next checked page in the rotation list."
msgstr "手动翻屏切换至下一个已勾选的显示页面。"

msgid "Double Click: "
msgstr "双击屏幕按键："

msgid "Jump directly back to the first checked page."
msgstr "立即跳回第一个已勾选的页面。"

msgid "Long Press (1.5s): "
msgstr "长按屏幕按键 (1.5秒)："

msgid "Toggle screen standby power (turn display ON or OFF)."
msgstr "切换屏幕待机供电（点亮或熄灭点阵屏）。"

msgid "General Settings"
msgstr "基本设置"

msgid "Enabled"
msgstr "启用服务"

msgid "Enable or disable the Athena LED screen service."
msgstr "开启或禁用雅典娜 LED 屏幕后台守护进程。"

msgid "Brightness Level"
msgstr "屏幕亮度级别"

msgid "Panel brightness level (0 to 7)."
msgstr "点阵屏硬件亮度级别（0 到 7）。"

msgid " (Dimmest)"
msgstr " (最暗)"

msgid " (Default)"
msgstr " (默认)"

msgid " (Brightest)"
msgstr " (最亮)"

msgid "Page Display Time (seconds)"
msgstr "页面停留时间 (秒)"

msgid "Seconds to stay on each page before switching. Set to 0 for manual button flipping only (no auto-rotation). Greater than 0 enables automatic flipping."
msgstr "页面自动轮播停留时间（秒）。设置为 0 则完全不自动翻屏，仅通过机身按键手动切页；大于 0 则自动定时翻屏。"

msgid "Traffic Monitor Interface"
msgstr "流量监控网卡接口"

msgid "Network interface to monitor throughput for download and upload pages."
msgstr "上下行网速监控所统计的网卡接口（例如 wan 或 br-lan）。"

msgid "Advanced Tuning"
msgstr "高级调优"

msgid "Sampling Interval (ms)"
msgstr "采样与刷新周期 (毫秒)"

msgid "Sampling and display refresh interval in milliseconds (default 250ms)."
msgstr "监控数据采样与屏幕刷新周期（默认 250ms）。"

msgid "Network Rate Smoothing (seconds)"
msgstr "网络速率平滑时间（秒）"

msgid "Exponential moving average time constant for network rates. Set to 0 to disable smoothing; larger values change more slowly."
msgstr "网络速率的指数移动平均时间常数。设为 0 表示关闭平滑；数值越大变化越慢。"

msgid "Service Control"
msgstr "服务操作"

msgid "Restart Service"
msgstr "重启服务"

msgid "Restart"
msgstr "重启"

msgid "Stop Service"
msgstr "停止服务"

msgid "Stop"
msgstr "停止"

msgid "Start Service"
msgstr "启动服务"

msgid "Start"
msgstr "启动"

msgid "CPU Indicator Threshold (%)"
msgstr "CPU 指示灯阈值 (%)"

msgid "Light the CPU indicator when total CPU usage exceeds this percentage."
msgstr "当整体 CPU 使用率超过该百分比时点亮 CPU 指示灯。"

msgid "Network Indicator Threshold (KB/s)"
msgstr "网络指示灯阈值 (KB/s)"

msgid "Light the up/down indicators when the corresponding direction exceeds this rate in KB/s (1 KB = 1000 bytes)."
msgstr "当上传或下载速率超过该 KB/s 阈值时点亮对应方向指示灯（1 KB = 1000 字节）。"
